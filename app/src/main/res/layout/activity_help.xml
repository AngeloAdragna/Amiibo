<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:background="?attr/colorPrimary"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".activity.HelpActivity">

    <!--_____________________ Toolbar avec image utilisateur et niveau _____________________-->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:background="?attr/colorPrimary"
        android:paddingTop="35dp"
        android:paddingEnd="15dp"
        android:theme="@style/ThemeOverlay.AppCompat.ActionBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:popupTheme="@style/ThemeOverlay.AppCompat.Light"
        app:title=""
        app:titleTextColor="@color/whiteTextAndButtonColor"
        tools:ignore="RtlSymmetry">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="start|center_vertical"
            android:layout_marginEnd="0dp"
            android:orientation="horizontal">

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/iconImageView"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:layout_gravity="center"
                android:layout_margin="5dp"
                android:scaleType="fitCenter"
                android:src="@drawable/circular_bg" />

            <TextView
                android:id="@+id/labelLevelUser"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginTop="-7dp"
                android:layout_weight="3"
                android:textSize="22sp"
                android:gravity="end|center_vertical"
                android:text="@string/level" />

            <TextView
                android:id="@+id/levelUser"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginTop="-7dp"
                android:layout_weight="1"
                android:textSize="22sp"
                android:gravity="center|center_vertical"
                android:text="" />

        </LinearLayout>
    </androidx.appcompat.widget.Toolbar>

    <!--_____________________ Nom de l'utilisateur _____________________-->
    <TextView
        android:id="@+id/user"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_weight="1"
        android:textSize="30sp"
        android:text=""
        app:layout_constraintStart_toStartOf="@+id/toolbar"
        app:layout_constraintTop_toBottomOf="@+id/toolbar" />

    <!--_____________________ Bloc niveau _____________________-->
    <TextView
        android:id="@+id/labelLevel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:text="@string/niveau"
        android:paddingTop="10dp"
        android:textSize="22sp"
        app:layout_constraintEnd_toEndOf="@id/level"
        app:layout_constraintStart_toStartOf="@id/level"
        app:layout_constraintTop_toBottomOf="@+id/user" />

    <LinearLayout
        android:id="@+id/level"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="50dp"
        android:layout_marginEnd="50dp"
        android:background="@drawable/bg_dark"
        android:gravity="center"
        android:padding="5dp"
        android:orientation="vertical"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/labelLevel">

        <TextView
            android:id="@+id/pts_niveau"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:padding="10dp"
            android:textSize="21sp"
            android:textColor="@android:color/white" />

        <TextView
            android:id="@+id/pts_to_next_level"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:padding="10dp"
            android:textSize="21sp"
            android:textColor="@android:color/white" />
    </LinearLayout>

    <!--_____________________ Ombres bloc niveau _____________________-->
    <View
        android:layout_width="0dp"
        android:layout_height="10dp"
        android:background="@drawable/bg_dark_shadow_top"
        app:layout_constraintTop_toTopOf="@id/level"
        app:layout_constraintEnd_toEndOf="@+id/level"
        app:layout_constraintStart_toStartOf="@+id/level" />

    <View
        android:layout_width="0dp"
        android:layout_height="5dp"
        android:layout_marginTop="-5dp"
        android:background="@drawable/bg_dark_shadow_bottom"
        app:layout_constraintTop_toBottomOf="@id/level"
        app:layout_constraintEnd_toEndOf="@+id/level"
        app:layout_constraintStart_toStartOf="@+id/level" />

    <View
        android:layout_width="5dp"
        android:layout_height="0dp"
        android:layout_marginStart="-5dp"
        android:layout_marginBottom="1dp"
        android:background="@drawable/bg_dark_shadow_side"
        app:layout_constraintBottom_toBottomOf="@id/level"
        app:layout_constraintStart_toEndOf="@id/level"
        app:layout_constraintTop_toTopOf="@id/level" />

    <View
        android:layout_width="5dp"
        android:layout_height="0dp"
        android:rotation="180"
        android:layout_marginBottom="1dp"
        android:background="@drawable/bg_dark_shadow_side"
        app:layout_constraintTop_toTopOf="@id/level"
        app:layout_constraintBottom_toBottomOf="@id/level"
        app:layout_constraintStart_toStartOf="@id/level" />

    <!--_____________________ Bloc score _____________________-->
    <TextView
        android:id="@+id/labelScore"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:text=""
        android:paddingTop="10dp"
        android:textSize="22sp"
        app:layout_constraintEnd_toEndOf="@id/level"
        app:layout_constraintStart_toStartOf="@id/level"
        app:layout_constraintTop_toBottomOf="@+id/level" />

    <LinearLayout
        android:id="@+id/score"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="50dp"
        android:layout_marginEnd="50dp"
        android:background="@drawable/bg_dark"
        android:gravity="center"
        android:padding="5dp"
        android:orientation="vertical"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/labelScore">

        <TextView
            android:id="@+id/nb_played"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:padding="10dp"
            android:textSize="21sp"
            android:textColor="@android:color/white" />

        <TextView
            android:id="@+id/nb_good_answer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:padding="10dp"
            android:textSize="21sp"
            android:textColor="@android:color/white" />

        <TextView
            android:id="@+id/nb_bad_answer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:padding="10dp"
            android:textSize="21sp"
            android:textColor="@android:color/white" />
    </LinearLayout>

    <!--_____________________ Ombres bloc score _____________________-->
    <View
        android:layout_width="0dp"
        android:layout_height="10dp"
        android:background="@drawable/bg_dark_shadow_top"
        app:layout_constraintTop_toTopOf="@id/score"
        app:layout_constraintEnd_toEndOf="@+id/score"
        app:layout_constraintStart_toStartOf="@+id/score" />

    <View
        android:layout_width="0dp"
        android:layout_height="5dp"
        android:layout_marginTop="-5dp"
        android:background="@drawable/bg_dark_shadow_bottom"
        app:layout_constraintTop_toBottomOf="@id/score"
        app:layout_constraintEnd_toEndOf="@+id/score"
        app:layout_constraintStart_toStartOf="@+id/score" />

    <View
        android:layout_width="5dp"
        android:layout_height="0dp"
        android:layout_marginStart="-5dp"
        android:layout_marginBottom="1dp"
        android:background="@drawable/bg_dark_shadow_side"
        app:layout_constraintBottom_toBottomOf="@id/score"
        app:layout_constraintStart_toEndOf="@id/score"
        app:layout_constraintTop_toTopOf="@id/score" />

    <View
        android:layout_width="5dp"
        android:layout_height="0dp"
        android:rotation="180"
        android:layout_marginBottom="1dp"
        android:background="@drawable/bg_dark_shadow_side"
        app:layout_constraintTop_toTopOf="@id/level"
        app:layout_constraintBottom_toBottomOf="@id/level"
        app:layout_constraintStart_toStartOf="@id/level" />

    <!--_____________________ Bloc règles _____________________-->
    <TextView
        android:id="@+id/labelRule"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:text=""
        android:paddingTop="10dp"
        android:textSize="22sp"
        app:layout_constraintEnd_toEndOf="@id/rule"
        app:layout_constraintStart_toStartOf="@id/rule"
        app:layout_constraintTop_toBottomOf="@+id/score" />

    <TextView
        android:id="@+id/rule"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="50dp"
        android:layout_marginEnd="50dp"
        android:background="@drawable/bg_dark"
        android:gravity="center"
        android:padding="10dp"
        android:text="@string/quizz"
        android:textSize="20sp"
        android:textColor="@android:color/white"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/labelRule" />

    <!--_____________________ Ombres bloc règles _____________________-->
    <View
        android:layout_width="0dp"
        android:layout_height="10dp"
        android:background="@drawable/bg_dark_shadow_top"
        app:layout_constraintTop_toTopOf="@id/rule"
        app:layout_constraintEnd_toEndOf="@+id/rule"
        app:layout_constraintStart_toStartOf="@+id/rule" />

    <View
        android:layout_width="0dp"
        android:layout_height="5dp"
        android:layout_marginTop="-5dp"
        android:background="@drawable/bg_dark_shadow_bottom"
        app:layout_constraintTop_toBottomOf="@id/rule"
        app:layout_constraintEnd_toEndOf="@+id/rule"
        app:layout_constraintStart_toStartOf="@+id/rule" />

    <View
        android:layout_width="5dp"
        android:layout_height="0dp"
        android:layout_marginStart="-5dp"
        android:layout_marginBottom="1dp"
        android:background="@drawable/bg_dark_shadow_side"
        app:layout_constraintBottom_toBottomOf="@id/rule"
        app:layout_constraintStart_toEndOf="@id/rule"
        app:layout_constraintTop_toTopOf="@id/rule" />

    <View
        android:layout_width="5dp"
        android:layout_height="0dp"
        android:rotation="180"
        android:layout_marginBottom="1dp"
        android:background="@drawable/bg_dark_shadow_side"
        app:layout_constraintTop_toTopOf="@id/rule"
        app:layout_constraintBottom_toBottomOf="@id/rule"
        app:layout_constraintStart_toStartOf="@id/rule" />

</androidx.constraintlayout.widget.ConstraintLayout>
